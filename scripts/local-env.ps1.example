# 本机构建环境（不要提交）。复制为 local-env.ps1 后按需修改。
# 由 scripts/build-all.ps1 在存在时自动加载；手动构建请先 `. .\scripts\local-env.ps1`
#
# 用法：
#   copy scripts\local-env.ps1.example scripts\local-env.ps1
#   然后按本机实际路径修改下面各项
#
# 注意：JAVA_HOME 必须是完整 JDK（含 javac），Gradle 要求 JDK 17–21。
#       路径写错时 Gradle 报错很隐蔽，配完请验证：
#       & "$env:JAVA_HOME\bin\java.exe" -version

$env:FTCORE_DEPS_ROOT   = 'E:\zheten2.0\.deps'
$env:CARGO_HOME         = 'E:\zheten2.0\.deps\cargo'
$env:RUSTUP_HOME        = 'E:\zheten2.0\.deps\rustup'
$env:PUB_CACHE          = 'E:\zheten2.0\.deps\pub-cache'
$env:JAVA_HOME          = 'D:\jdk21\jdk-21.0.12.1+1'
$env:ANDROID_HOME       = 'E:\zheten2.0\.deps\android-sdk'
$env:ANDROID_SDK_ROOT   = $env:ANDROID_HOME
$env:GRADLE_USER_HOME   = 'E:\zheten2.0\.deps\gradle'
$env:TEMP               = 'E:\zheten2.0\.deps\tmp'
$env:TMP                = $env:TEMP
$env:FTCORE_TEST_TMP    = 'E:\zheten2.0\.deps\tmp'
